# 文本、SVG 与 AI 排版：支持 OpenAI Chat Completions 兼容服务。
AI_API_KEY=replace_with_your_chat_provider_key
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# 可选：文生图服务。应支持 POST /images/generations；未设置时复用 AI_API_BASE、AI_MODEL 和 AI_API_KEY。
# 如图像提供商使用独立密钥，请只在服务器环境设置 AI_IMAGE_API_KEY。
AI_IMAGE_API_KEY=
AI_IMAGE_BASE=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1

PORT=4173
